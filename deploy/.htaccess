# antar.narekohanyan.com -- served from the folder public_html/antar on Hostinger (Apache/LiteSpeed reads this file).
# This folder is also reachable as narekohanyan.com/antar/, so the first rules send every other spelling to the one address.
# Copied into the site by scripts/build_site.py; tested against a real Apache in tests/test_site_bundle.py.

DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# 1. one address: the subdomain (not narekohanyan.com/antar/), over https, without /index.html
RewriteCond %{HTTP_HOST} !^antar\.narekohanyan\.com$ [NC]
RewriteRule ^(.*)$ https://antar.narekohanyan.com/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://antar.narekohanyan.com/$1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# 2. file types a plain Apache may not know
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/geo+json .geojson
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType application/octet-stream .bin
</IfModule>

# 3. caching: the page is always revalidated, so a new build is seen at once; scripts, styles and data carry a ?v= build stamp
#    in every request, so a stamp never points at a changed file; everything else (photographs, fonts, video) is kept for a week
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|json|geojson)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # the map rasters are data, not pictures (assets/map/*.bin, lossless PNG bytes): a host that converts images must leave them alone
  <FilesMatch "\.bin$">
    Header set Cache-Control "public, max-age=3600, must-revalidate, no-transform"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/geo+json image/svg+xml
</IfModule>
