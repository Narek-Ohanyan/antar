# ANTAR workflow (Snakemake). Every rule runs a real, existing script and produces a real fitted
# output under configs/fitted/ -- there are no placeholder `echo` rules. The earlier skeleton's
# stages that have no implementation yet (master-grid zarr, hydraulic emulator, nested blocked-CV
# validation report, Sobol variance decomposition) are deliberately NOT declared here as fake
# rules; they are listed under "Not yet implemented" at the bottom so the DAG never claims work
# that does not exist.
#
#   snakemake --cores 4 --resources drive_streams=1            # 80-point validation grid
#   snakemake --cores 4 --resources drive_streams=1 --config dense=true   # 1044-point dense grid
#   snakemake -n                                                # dry run: print the plan only
#
# `--resources drive_streams=1` serialises the steps that stream rasters from Google Drive. Running
# them concurrently was observed to degrade/throttle reads (see IMPLEMENTATION_LOG.md, 2026-10-02
# to 2026-10-04); Snakemake does not enforce the limit unless you pass it.
#
# Raw data pulls (pull_*.py, register_*.py, submit_*.py) are intentionally outside this DAG: they
# are one-off, network-bound, and several take hours. Their products live under data/ (gitignored)
# and are declared below as ancient() inputs so they are checked for existence but never trigger
# a re-pull. See configs/manifests/ for the provenance of each.
configfile: "configs/study_area.yaml"

DENSE = bool(config.get("dense", False))
SUF = "_dense" if DENSE else ""
FLAG = "--dense" if DENSE else ""
FITTED = "configs/fitted"
PY = "python3"

CHELSA_DAILY = ancient("data/chelsa")
ISIMIP = ancient("data/isimip3b")
ECOSYSTEM_MAP = ancient("data/ecosystem_map")
BIOCLIM = ancient("data/chelsa_bioclim")


rule all:
    input:
        f"{FITTED}/aegis_portfolio{SUF}.yaml",
        f"{FITTED}/treeline_change{SUF}.yaml",
        f"{FITTED}/mneme_hazard_panel_2010_2019{SUF}.yaml",
        f"{FITTED}/xylem_mechanistic_hazard_2019{SUF}.yaml",
        f"{FITTED}/variogram{SUF}.yaml",
        f"{FITTED}/meristem_adult_niche.yaml",
        "ui/data/manifest.json",


# --- TOPOHYDRO -------------------------------------------------------------------------------
rule lapse_rate:        # monthly temperature lapse rate + precipitation gradient from GHCN-D stations
    input: "data/_staging_ghcnd"
    output: f"{FITTED}/topohydro_lapse_rate.yaml"
    shell: f"{PY} scripts/fit_topohydro_lapse_rate.py"


rule topohydro:         # gridded downscaled forcing + water balance (CWD, WSI, GDD, growing season)
    input: f"{FITTED}/topohydro_lapse_rate.yaml", CHELSA_DAILY
    output: f"{FITTED}/topohydro_grid_run_2019{SUF}.yaml"
    params: flag=FLAG
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/run_topohydro_grid.py {{params.flag}}"


# --- XYLEM / REFUGIUM / MNEME ----------------------------------------------------------------
rule xylem:             # mechanistic hydraulic-failure hazard, two-level Monte Carlo, per functional group
    input:
        f"{FITTED}/topohydro_lapse_rate.yaml", "configs/species_traits.csv",
        f"{FITTED}/xylem_trait_hyper_sd.yaml", CHELSA_DAILY,
    output: f"{FITTED}/xylem_mechanistic_hazard_2019{SUF}.yaml"
    params: flag=FLAG
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/fit_xylem_mechanistic_hazard.py {{params.flag}}"


rule refugium:          # viability + robust-refugium criterion (a) from XYLEM's hazard ensemble
    input:
        f"{FITTED}/topohydro_lapse_rate.yaml", "configs/species_traits.csv",
        f"{FITTED}/xylem_trait_hyper_sd.yaml", CHELSA_DAILY,
    output: f"{FITTED}/refugium_viability_2019{SUF}.yaml"
    params: flag=FLAG
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/fit_refugium_viability.py {{params.flag}}"


rule mneme:             # person-period dieback panel + stacked hazard fit (reports a null result if events < 2)
    input: f"{FITTED}/topohydro_lapse_rate.yaml", CHELSA_DAILY
    output: f"{FITTED}/mneme_hazard_panel_2010_2019{SUF}.yaml"
    params: flag=FLAG
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/fit_mneme_hazard_panel.py {{params.flag}}"


# --- MERISTEM --------------------------------------------------------------------------------
rule meristem:          # per-species presence-background adult niche (GBIF + CHELSA bioclim)
    input: "configs/gbif_occurrences_armenia.csv", BIOCLIM
    output: f"{FITTED}/meristem_adult_niche.yaml"
    shell: f"{PY} scripts/fit_meristem_adult_niche.py"


# --- Treeline --------------------------------------------------------------------------------
rule treeline_diagnostic:   # today's (2019) potential-treeline elevation per cell
    input: f"{FITTED}/topohydro_lapse_rate.yaml", CHELSA_DAILY
    output: f"{FITTED}/treeline_diagnostic_2019.yaml"
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/compute_treeline_diagnostic.py"


rule treeline_change:       # treeline shift across the 45-member ISIMIP3b ensemble (delta method)
    input: f"{FITTED}/treeline_diagnostic_2019.yaml", f"{FITTED}/topohydro_lapse_rate.yaml", ISIMIP, CHELSA_DAILY
    output: f"{FITTED}/treeline_change{SUF}.yaml"
    params: flag=FLAG
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/compute_treeline_change.py {{params.flag}}"


# --- Future projections, ecosystem-map validation, decision ----------------------------------
rule future_projections:    # 45-member (5 GCM x 3 SSP x 3 horizon) viability ensemble, delta-method downscaling
    input:
        f"{FITTED}/topohydro_lapse_rate.yaml", "configs/species_traits.csv",
        f"{FITTED}/xylem_trait_hyper_sd.yaml", ISIMIP, CHELSA_DAILY,
    output: f"{FITTED}/future_projections{SUF}.yaml"
    params: flag=FLAG
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/run_future_projections.py {{params.flag}}"


rule ecosystem_ground_truth:    # real Ecosystem Map of Armenia: validation correlations + human-modified exclusion
    input: f"{FITTED}/refugium_viability_2019.yaml", ECOSYSTEM_MAP
    output: f"{FITTED}/ecosystem_ground_truth_2019.yaml"
    shell: f"{PY} scripts/integrate_ecosystem_map.py"


rule aegis:                 # CVaR-robust portfolio over options x scenarios, budget sweep + efficient frontier
    input:
        f"{FITTED}/future_projections{SUF}.yaml", f"{FITTED}/ecosystem_ground_truth_2019.yaml",
        ECOSYSTEM_MAP,
    output: f"{FITTED}/aegis_portfolio{SUF}.yaml"
    params: flag=FLAG
    resources: drive_streams=1
    retries: 5
    shell: f"{PY} scripts/fit_aegis_portfolio.py {{params.flag}}"


# --- Sampling-design diagnostics -------------------------------------------------------------
rule variogram:         # empirical variogram of elevation-detrended CWD -> informs configs/cv.yaml block size
    input: f"{FITTED}/topohydro_grid_run_2019{SUF}.yaml"
    output: f"{FITTED}/variogram{SUF}.yaml"
    params: flag=FLAG
    shell: f"{PY} scripts/estimate_variogram.py {{params.flag}}"


# --- UI --------------------------------------------------------------------------------------
rule map_assets:        # forest cover, water, marz ids and borders on one Web-Mercator grid (no basemap needed)
    input:
        ancient("data/ecosystem_map/Ecosystem_Map_of_Armenia.tif"),
        ancient("data/boundaries/geoBoundaries-ARM-ADM1.geojson"),
    output: "ui/assets/map/grid.json"
    shell: f"{PY} scripts/build_map_assets.py"


rule ui_data:           # bundle every real fitted output into ui/data/*.json for the static UI
    input:
        f"{FITTED}/topohydro_grid_run_2019{SUF}.yaml",
        f"{FITTED}/xylem_mechanistic_hazard_2019{SUF}.yaml",
        f"{FITTED}/refugium_viability_2019{SUF}.yaml",
        f"{FITTED}/future_projections{SUF}.yaml",
        f"{FITTED}/treeline_change{SUF}.yaml",
        f"{FITTED}/aegis_portfolio{SUF}.yaml",
        f"{FITTED}/mneme_hazard_panel_2010_2019{SUF}.yaml",
        f"{FITTED}/variogram{SUF}.yaml",
        f"{FITTED}/meristem_adult_niche.yaml",
        f"{FITTED}/ecosystem_ground_truth_2019.yaml",
    output: "ui/data/manifest.json"
    shell: f"{PY} ui/build_data.py"


# --- Not yet implemented (deliberately not declared as rules) ---------------------------------
#  * nested blocked cross-validation per configs/cv.yaml (needs a denser grid and, for MNEME, real events)
#  * monotone hydraulic emulator surrogate
#  * Sobol / variance-decomposition uncertainty stage
#  * full Eq. 7.3 MNEME design (age spline, DLNM cross-basis) -- needs real stand-age / structure data
#  * MERISTEM attainable-height model fit (needs real height/growth data)
